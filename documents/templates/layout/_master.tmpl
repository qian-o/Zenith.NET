{{!include(/^public/.*/)}}
<!DOCTYPE html>
<html lang="{{_lang}}{{^_lang}}en{{/_lang}}" data-bs-theme="dark">
  <head>
    <meta charset="utf-8">
    <meta name="color-scheme" content="dark">
    {{#redirect_url}}
      <meta http-equiv="refresh" content="0;URL='{{redirect_url}}'">
    {{/redirect_url}}
    {{^redirect_url}}
      <title>{{#title}}{{title}}{{/title}}{{^title}}{{>partials/title}}{{/title}} {{#_appTitle}}| {{_appTitle}} {{/_appTitle}}</title>
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <meta name="title" content="{{#title}}{{title}}{{/title}}{{^title}}{{>partials/title}}{{/title}} {{#_appTitle}}| {{_appTitle}} {{/_appTitle}}">
      {{#_description}}<meta name="description" content="{{_description}}">{{/_description}}
      {{#description}}<meta name="description" content="{{description}}">{{/description}}
      <link rel="icon" href="{{_rel}}{{{_appFaviconPath}}}">
      <link rel="stylesheet" href="{{_rel}}public/main.css">
      {{#_apiReference}}<link rel="stylesheet" href="{{_rel}}public/api.css">{{/_apiReference}}
      <meta name="docfx:navrel" content="{{_navRel}}">
      <meta name="docfx:tocrel" content="{{_tocRel}}">
      {{#_noindex}}<meta name="searchOption" content="noindex">{{/_noindex}}
      {{#_enableSearch}}<meta name="docfx:rel" content="{{_rel}}">{{/_enableSearch}}
      {{#_disableNewTab}}<meta name="docfx:disablenewtab" content="true">{{/_disableNewTab}}
      {{#_disableTocFilter}}<meta name="docfx:disabletocfilter" content="true">{{/_disableTocFilter}}
      {{#docurl}}<meta name="docfx:docurl" content="{{docurl}}">{{/docurl}}
      <meta name="loc:inThisArticle" content="{{__global.inThisArticle}}">
      <meta name="loc:searchResultsCount" content="{{__global.searchResultsCount}}">
      <meta name="loc:searchNoResults" content="{{__global.searchNoResults}}">
      <meta name="loc:tocFilter" content="{{__global.tocFilter}}">
      <meta name="loc:themeLight" content="{{__global.themeLight}}">
      <meta name="loc:themeDark" content="{{__global.themeDark}}">
      <meta name="loc:themeAuto" content="{{__global.themeAuto}}">
      <meta name="loc:changeTheme" content="{{__global.changeTheme}}">
      <meta name="loc:copy" content="{{__global.copy}}">
      <meta name="loc:downloadPdf" content="{{__global.downloadPdf}}">

      <script type="module" src="{{_rel}}public/docfx.min.js"></script>

      <script>
        // Keep DocFX initialization aligned with the fixed dark page, including old saved preferences.
        localStorage.setItem('theme', 'dark')
      </script>

      {{#_googleAnalyticsTagId}}
      <script async src="https://www.googletagmanager.com/gtag/js?id={{_googleAnalyticsTagId}}"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', '{{_googleAnalyticsTagId}}');
      </script>
      {{/_googleAnalyticsTagId}}
    {{/redirect_url}}
  </head>

  {{^redirect_url}}
  <body class="tex2jax_ignore zenith-theme" data-layout="{{_layout}}{{layout}}" data-yaml-mime="{{yamlmime}}" data-page-kind="{{_pageKind}}" data-section="{{_section}}">
    {{>partials/site.header}}

    <main class="container-xxl">
      {{>partials/site.sidebar}}

      <div class="content">
        {{^_disableToc}}
        {{#apiHasMemberFinder}}<div class="api-mobile-tools">{{/apiHasMemberFinder}}
        <button class="contents-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#tocOffcanvas" aria-controls="tocOffcanvas" aria-label="Open contents">
          <i class="bi bi-list" aria-hidden="true"></i><span>Contents</span>
        </button>
        {{#apiHasMemberFinder}}
        {{>partials/api.member-launcher}}
        </div>
        {{/apiHasMemberFinder}}
        {{/_disableToc}}

        <article data-uid="{{uid}}">
          {{!body}}
        </article>
      </div>

      {{^_disableAffix}}
      <aside class="affix article-outline">
        <nav id="article-outline" aria-label="On this page"></nav>
      </aside>
      {{/_disableAffix}}
    </main>

    {{>partials/site.member-finder}}

    {{>partials/site.search}}

    {{>partials/site.footer}}
  </body>
  {{/redirect_url}}
</html>
