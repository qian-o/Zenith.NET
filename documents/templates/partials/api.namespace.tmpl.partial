{{!Based on the .NET Foundation DocFX templates, licensed under the MIT license.}}
{{#children}}
<section class="api-group" aria-labelledby="{{id}}">
  <div class="api-group-heading"><h2 id="{{id}}" data-resource="{{apiTitleKey}}">{{apiTitle}}</h2></div>
  <div class="api-type-grid">
    {{#children}}
    <div class="api-type-entry"><a href="{{href}}">{{name.0.value}}</a>{{#summary}}<div class="api-summary">{{{summary}}}</div>{{/summary}}</div>
    {{/children}}
  </div>
</section>
{{/children}}
