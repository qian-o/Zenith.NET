{{!Based on the .NET Foundation DocFX templates, licensed under the MIT license.}}
{{#parameters.0}}<div class="api-signature-section"><h4>Parameters</h4><dl class="api-parameters">{{#parameters}}<div><dt><code>{{id}}</code><span>{{{type.specName.0.value}}}</span></dt><dd>{{{description}}}</dd></div>{{/parameters}}</dl></div>{{/parameters.0}}
{{#typeParameters.0}}<div class="api-signature-section"><h4>Type parameters</h4><dl class="api-parameters">{{#typeParameters}}<div><dt><code>{{id}}</code></dt><dd>{{{description}}}</dd></div>{{/typeParameters}}</dl></div>{{/typeParameters.0}}
{{#return}}<dl class="api-value"><dt>Returns</dt><dd>{{{type.specName.0.value}}}{{#description}}<div>{{{description}}}</div>{{/description}}</dd></dl>{{/return}}
{{#fieldValue}}<dl class="api-value"><dt>Type</dt><dd>{{{type.specName.0.value}}}{{#description}}<div>{{{description}}}</div>{{/description}}</dd></dl>{{/fieldValue}}
{{#propertyValue}}<dl class="api-value"><dt>Type</dt><dd>{{{type.specName.0.value}}}{{#description}}<div>{{{description}}}</div>{{/description}}</dd></dl>{{/propertyValue}}
{{#eventType}}<dl class="api-value"><dt>Type</dt><dd>{{{type.specName.0.value}}}{{#description}}<div>{{{description}}}</div>{{/description}}</dd></dl>{{/eventType}}
