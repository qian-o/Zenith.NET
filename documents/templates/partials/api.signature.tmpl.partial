{{!Based on the .NET Foundation DocFX templates, licensed under the MIT license.}}
{{#apiTypeParameterDescriptions.0}}
    <div class="api-signature-section">
        <h4 data-resource="ui.reference.typeParameters">{{r.ui.reference.typeParameters}}</h4>
        <dl class="api-parameters">
            {{#apiTypeParameterDescriptions}}
                <div>
                    <dt><code>{{id}}</code></dt>
                    <dd>{{{description}}}</dd>
                </div>
            {{/apiTypeParameterDescriptions}}
        </dl>
    </div>
{{/apiTypeParameterDescriptions.0}}
{{#apiParameterDescriptions.0}}
    <div class="api-signature-section">
        <h4 data-resource="ui.reference.parameters">{{r.ui.reference.parameters}}</h4>
        <dl class="api-parameters">
            {{#apiParameterDescriptions}}
                <div>
                    <dt><code>{{id}}</code></dt>
                    <dd>{{{description}}}</dd>
                </div>
            {{/apiParameterDescriptions}}
        </dl>
    </div>
{{/apiParameterDescriptions.0}}
{{#apiResult}}
    {{#showType}}
        <dl class="api-value">
            <dt data-resource="{{labelKey}}">{{label}}</dt>
            <dd>{{{type}}}
                {{#description}}
                    <div>{{{description}}}</div>
                {{/description}}
            </dd>
        </dl>
    {{/showType}}
    {{^showType}}
        {{#description}}
            <div class="api-signature-section">
                <h4 data-resource="{{labelKey}}">{{label}}</h4>
                <div class="api-value-description">{{{description}}}</div>
            </div>
        {{/description}}
    {{/showType}}
{{/apiResult}}
