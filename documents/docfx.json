{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../sources",
          "files": "**/*.csproj",
          "exclude": "Experiments/**"
        }
      ],
      "output": "api",
      "enumSortOrder": "declaringOrder"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**/*.{md,yml}",
          "learn/**/*.md",
          "index.md",
          "toc.yml",
          "locales/*/strings.yml"
        ]
      }
    ],
    "resource": {
      "files": "images/**"
    },
    "template": [
      "default",
      "modern",
      "templates"
    ],
    "fileMetadata": {
      "_section": {
        "learn/**": "learn",
        "api/**": "api"
      },
      "_apiReference": {
        "api/**": true
      },
      "_disableAffix": {
        "api/**": true,
        "learn/index.md": true
      },
      "_disableToc": {
        "learn/**": false,
        "api/**": false
      }
    },
    "globalMetadata": {
      "_appTitle": "Zenith.NET",
      "_appLogoPath": "images/Zenith.NET-Logo.svg",
      "_appFaviconPath": "images/Zenith.NET.svg",
      "_enableSearch": true,
      "_gitContribute": {
        "repo": "https://github.com/qian-o/Zenith.NET",
        "branch": "master"
      },
      "_languages": [
        {
          "code": "de-DE",
          "label": "Deutsch"
        },
        {
          "code": "en-US",
          "label": "English"
        },
        {
          "code": "es-ES",
          "label": "Español"
        },
        {
          "code": "fr-FR",
          "label": "Français"
        },
        {
          "code": "ja-JP",
          "label": "日本語"
        },
        {
          "code": "ko-KR",
          "label": "한국어"
        },
        {
          "code": "pt-BR",
          "label": "Português (Brasil)"
        },
        {
          "code": "ru-RU",
          "label": "Русский"
        },
        {
          "code": "zh-CN",
          "label": "简体中文"
        },
        {
          "code": "zh-TW",
          "label": "繁體中文"
        }
      ],
      "_lang": "en-US",
      "_sourceLanguage": "en-US"
    },
    "output": "_site",
    "sitemap": {
      "baseUrl": "https://qian-o.github.io/Zenith.NET/"
    }
  }
}