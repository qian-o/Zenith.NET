{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../sources",
          "files": [
            "**/*.csproj"
          ],
          "exclude": [
            "Experiments/**"
          ]
        }
      ],
      "output": "api",
      "enumSortOrder": "declaringOrder"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**/*.{md,yml}",
          "learn/**/*.{md,yml}",
          "index.md",
          "toc.yml"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "template": [
      "default",
      "modern",
      "templates"
    ],
    "fileMetadata": {
      "_section": {
        "learn/**": "learn",
        "api/**": "api"
      },
      "_apiReference": {
        "api/**": true
      },
      "_disableAffix": {
        "api/**": true
      },
      "_disableTocFilter": {
        "learn/**": true
      }
    },
    "globalMetadata": {
      "_appTitle": "Zenith.NET",
      "_appLogoPath": "images/Zenith.NET-Logo.svg",
      "_appFaviconPath": "images/Zenith.NET.svg",
      "_enableSearch": true,
      "_appFooter": "Zenith.NET is a modern rendering hardware interface for .NET.",
      "_gitContribute": {
        "repo": "https://github.com/qian-o/Zenith.NET",
        "branch": "master"
      }
    },
    "output": "_site",
    "sitemap": {
      "baseUrl": "https://qian-o.github.io/Zenith.NET/"
    }
  }
}
