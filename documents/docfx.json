{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../sources",
          "files": [
            "**/*.csproj"
          ],
          "exclude": [
            "Experiments/**"
          ]
        }
      ],
      "output": "obj/api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.yml"
        ],
        "src": "obj/api",
        "dest": "api"
      },
      {
        "files": [
          "api/**/*.{md,yml}",
          "docs/**/*.{md,yml}",
          "tutorials/**/*.{md,yml}",
          "index.md",
          "toc.yml"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "templates"
    ],
    "globalMetadata": {
      "_appTitle": "Zenith.NET",
      "_appLogoPath": "images/Zenith.NET.svg",
      "_appFaviconPath": "images/Zenith.NET.png",
      "_gitContribute": {
        "repo": "https://github.com/qian-o/Zenith.NET",
        "branch": "master"
      }
    }
  }
}